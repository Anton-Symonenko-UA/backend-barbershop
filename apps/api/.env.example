NODE_ENV=development
PORT=4000
# Локально: npm run db:start (prisma dev), тоді DATABASE_URL нижче. Для продакшену: рядок з Neon.
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable"
# prisma dev тримає лише одне з'єднання: локально 1, у продакшені 10 або більше
DATABASE_POOL_MAX=1
# Адреса сайту для CORS
WEB_ORIGIN=http://localhost:3000
# Ключ для токенів, мінімум 32 байти: openssl rand -base64 32
AUTH_SECRET=
# NestJS Observe (необов'язково): npx @nestjs/observe link
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
# Тіньова база для prisma migrate dev (окремий порт prisma dev)
SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:51215/template1?sslmode=disable"
# Перший адміністратор для npm run db:seed
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
# Назва й телефон у SMS
SHOP_NAME=KREMEN
SHOP_PHONE=+380670000000
# Telegram-сповіщення адміну (необов'язково): бот від @BotFather, id чату через @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# SMS-підтвердження і нагадування клієнтам через turbosms.ua (необов'язково)
TURBOSMS_TOKEN=
TURBOSMS_SENDER=KREMEN
# Кількість реверс-проксі перед API (1 на Render/Fly/nginx), 0 локально
TRUST_PROXY=0
